[Unit]
Description=Validacion de Pagos a Proveedores
After=network.target

[Service]
Type=simple

# Ajustar si el usuario o la ruta son otros. Con la instalacion en el
# directorio del usuario, User y las rutas tienen que coincidir.
User=rbbaq
Group=rbbaq
WorkingDirectory=/home/rbbaq/checklist

# Los datos van en una carpeta aparte del codigo, para que un `git pull` no
# los toque nunca.
Environment=CHECKLIST_DATOS=/home/rbbaq/checklist-datos/datos
Environment=CHECKLIST_SUBIDAS=/home/rbbaq/checklist-datos/subidas
Environment=CHECKLIST_PLANTILLA=/home/rbbaq/checklist-datos/plantilla.xlsx

# Opcional: habilita el boton de segunda opinion con IA.
# Mejor con EnvironmentFile para no dejar la clave dentro de este archivo.
# EnvironmentFile=/home/rbbaq/checklist-datos/secretos.env

# Puerto 8030: en este servidor el 8000 y el 8020 ya estan ocupados.
#
# --timeout 180 porque el OCR del RADIAN tarda ~20 s por documento y el valor
# por omision de gunicorn (30 s) mataria al trabajador a mitad del proceso.
# Si el servidor tiene 1 o 2 nucleos, bajar --workers a 2.
ExecStart=/home/rbbaq/checklist/.venv/bin/gunicorn \
    --workers 3 \
    --timeout 180 \
    --graceful-timeout 30 \
    --bind 127.0.0.1:8030 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app

Restart=on-failure
RestartSec=5

# Endurecimiento moderado. Ojo: NO se usa ProtectHome porque la aplicacion
# vive en /home; con ProtectHome=true el servicio no arrancaria.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/rbbaq/checklist-datos

[Install]
WantedBy=multi-user.target
