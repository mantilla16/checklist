# Copiar como .env y ajustar. En el servidor estas variables se declaran en
# el archivo de systemd, no en un .env.

# Carpeta de la base de datos y del libro generado
CHECKLIST_DATOS=/var/lib/checklist/datos

# Carpeta de los PDF e imagenes cargados
CHECKLIST_SUBIDAS=/var/lib/checklist/subidas

# Plantilla de formato (el .xlsx del que se copia el diseno de las hojas)
CHECKLIST_PLANTILLA=/var/lib/checklist/plantilla.xlsx

# Solo para desarrollo local
CHECKLIST_HOST=127.0.0.1
CHECKLIST_PUERTO=5000
CHECKLIST_RECARGAR=1

# Cookie de sesion solo por HTTPS. Encenderla sobre HTTP plano impide entrar:
# el navegador no manda la cookie. Ponerla en 1 solo con certificado.
# CHECKLIST_COOKIE_SEGURA=1

# Secreto con el que se firman las cookies. Si no se indica, se genera solo en
# CHECKLIST_DATOS/clave-sesion y se reutiliza. Cambiarlo cierra las sesiones.
# CHECKLIST_SECRETO=

# Opcional: habilita el boton de segunda opinion con IA
# ANTHROPIC_API_KEY=
